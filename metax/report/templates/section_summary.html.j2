<div class="panel">
  <div class="panel-header">
    <div>
      <div class="panel-kicker">Report home</div>
      <h2>Your analysis at a glance</h2>
      <p class="panel-help">Use this page to confirm what was analyzed, then move through the report from charts to downloadable results.</p>
    </div>
    <div class="chip-row">
      {% for level in selected_taxa_levels %}
        <span class="chip">Taxa level {{ dataset_summary.get("selected_taxa_levels", [])[loop.index0] }}</span>
      {% endfor %}
      {% for function_name in selected_function_columns %}
        <span class="chip">{{ function_name }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="section-context" style="margin-bottom: 16px;">
    <strong>Main report:</strong>
    {{ dataset_summary.get("main_taxa_level", "None") }} taxa with
    {{ dataset_summary.get("main_function", "None") }} functions.
    <strong>Selected taxa levels:</strong> {{ dataset_summary.get("selected_taxa_levels", [])|join(", ") }}.
    <strong>Selected function columns:</strong> {{ dataset_summary.get("selected_function_columns", [])|join(", ") }}.
    Other combinations are listed under Extended results.
  </div>

  <div class="metric-grid">
    <div class="metric primary">
      <div class="label">Samples analyzed</div>
      <div class="value">{{ dataset_summary.get("n_samples", 0) }}</div>
      <div class="hint">Samples matched to the metadata table</div>
    </div>
    <div class="metric blue">
      <div class="label">Peptides</div>
      <div class="value">{{ dataset_summary.get("n_peptides", 0) }}</div>
      <div class="hint">Distinct sequences retained across analyzed samples</div>
    </div>
    <div class="metric coral">
      <div class="label">OTF tables</div>
      <div class="value">{{ dataset_summary.get("otf_counts", [])|length }}</div>
      <div class="hint">Feature counts are listed for every computed taxa-function table</div>
    </div>
    <div class="metric gold">
      <div class="label">Report outputs</div>
      <div class="value">{{ run_summary.n_tables + run_summary.n_figures }}</div>
      <div class="hint">{{ run_summary.n_tables }} tables and {{ run_summary.n_figures }} figures</div>
    </div>
  </div>

  {% set peptide_counts = dataset_summary.get("sample_peptide_counts", []) %}
  {% if peptide_counts %}
    {% set peptide_summary = dataset_summary.get("sample_peptide_summary", {}) %}
    {% set peptide_groups = dataset_summary.get("sample_peptide_groups", []) %}
    <details class="config-block" id="sample-peptide-details" data-search-scope style="margin-top: 16px;">
      <summary>Peptides by sample ({{ peptide_counts|length }})
        <span class="peptide-summary-metrics">Median {{ '%g'|format(peptide_summary.median) }} · Range {{ peptide_summary.min }}–{{ peptide_summary.max }}</span>
      </summary>
      {% set max_count = peptide_counts|max(attribute="count") %}
      {% set scale = max_count.count if max_count.count else 1 %}
      <div class="section-context">
        Distinct {{ config.input.peptide_col_name }} values with positive intensity in each sample. Each peptide is counted once per sample.
      </div>
      {% if peptide_groups|length > 1 %}
        <h3>Peptide count by {{ config.analysis.group_meta }}</h3>
        <p class="muted">Line: minimum to maximum · box: middle 50% · marker: median. All groups share the same scale.</p>
        <div class="peptide-group-list">
          {% for group in peptide_groups %}
            <div class="peptide-group-row">
              <span>{{ group.group }} <small>({{ group.n_samples }})</small></span>
              <div class="peptide-range" role="img" aria-label="{{ group.group }}: minimum {{ group.min }}, median {{ group.median }}, maximum {{ group.max }}">
                <span class="peptide-whisker" style="left: {{ 100 * group.min / scale }}%; width: {{ 100 * (group.max - group.min) / scale }}%"></span>
                <span class="peptide-box" style="left: {{ 100 * group.q1 / scale }}%; width: {{ 100 * (group.q3 - group.q1) / scale }}%"></span>
                <span class="peptide-median" style="left: {{ 100 * group.median / scale }}%"></span>
              </div>
              <strong>{{ '%g'|format(group.median) }}</strong>
            </div>
          {% endfor %}
        </div>
      {% endif %}
      <div class="toolbar">
        <input class="search-input" data-artifact-search type="search" aria-label="Search samples" placeholder="Search sample or group">
        <select class="search-input" data-peptide-sort aria-label="Sort samples">
          <option value="original">Sample order</option>
          <option value="high">Most peptides first</option>
          <option value="low">Fewest peptides first</option>
        </select>
      </div>
      <div class="sample-peptide-list" id="sample-peptide-list">
        {% for item in peptide_counts %}
          <div class="sample-peptide-row" data-search-item="{{ (item.sample ~ ' ' ~ item.group)|lower }}" data-count="{{ item.count }}" data-order="{{ loop.index0 }}">
            <span title="{{ item.sample }}">{{ item.sample }}{% if peptide_groups|length > 1 %}<small>{{ item.group }}</small>{% endif %}</span>
            <div class="sample-peptide-bar"><span style="width: {{ 100 * item.count / scale }}%"></span></div>
            <strong>{{ item.count }}</strong>
          </div>
        {% endfor %}
      </div>
      <a class="action-link" href="tables/qc/sample_qc.tsv">Download per-sample counts</a>
    </details>
  {% endif %}

  {% if dataset_summary.get("otf_counts") %}
    <div class="section-context" style="margin-top: 16px;">
      <strong>OTF feature counts:</strong>
      each card shows the number of taxa-function links generated for one taxa level and function annotation combination.
    </div>
    <div class="metric-grid">
      {% for item in dataset_summary.get("otf_counts", []) %}
        <div class="metric">
          <div class="label">{{ item.taxa_level }} / {{ item.function_column }}</div>
          <div class="value">{{ item.n_features }}</div>
          <div class="hint">{{ item.title }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="panel">
  <div class="panel-header">
    <div>
      <div class="panel-kicker">Unit-aware analysis</div>
      <h2>Analysis unit summary</h2>
    </div>
  </div>
  {% set unit = dataset_summary.get("unit_aware", {}) %}
  {% if unit.get("detected") %}
    <div class="metric-grid">
      <div class="metric primary">
        <div class="label">Analysis units</div>
        <div class="value">{{ unit.get("n_analysis_units", 0) }}</div>
        <div class="hint">Detected from {{ unit.get("unit_column") }}</div>
      </div>
      <div class="metric">
        <div class="label">Samples per unit</div>
        <div class="value">{{ unit.get("samples_per_unit", {})|length }}</div>
        <div class="hint">{{ unit.get("samples_per_unit", {}) }}</div>
      </div>
      {% if unit.get("records_per_unit") %}
      <div class="metric">
        <div class="label">Metadata records per unit</div>
        <div class="value">{{ unit.get("records_per_unit", {})|length }}</div>
        <div class="hint">{{ unit.get("records_per_unit", {}) }}</div>
      </div>
      {% endif %}
      {% if unit.get("features_per_unit") %}
      <div class="metric">
        <div class="label">Features per unit</div>
        <div class="value">{{ unit.get("features_per_unit", {})|length }}</div>
        <div class="hint">{{ unit.get("features_per_unit", {}) }}</div>
      </div>
      {% endif %}
      <div class="metric">
        <div class="label">Unit-specific assignment</div>
        <div class="value">{{ "Available" if unit.get("unit_specific_assignment_available") else "Not detected" }}</div>
        <div class="hint">Genome evidence and duplicate peptide handling fields are reserved for future reports.</div>
      </div>
    </div>
  {% else %}
    <div class="empty-state">No unit-aware metadata detected</div>
  {% endif %}
</div>

<div class="panel">
  <div class="panel-header">
    <div>
      <div class="panel-kicker">Recommended review path</div>
      <h2>Where to start</h2>
    </div>
  </div>
  <div class="task-grid">
    <div class="task-card">
      <div class="task-top"><div class="task-badge">1</div><h3>Check the dataset</h3></div>
      <p class="muted">Confirm sample count, selected taxa levels, and function annotation columns before interpreting the results.</p>
    </div>
    <div class="task-card">
      <div class="task-top"><div class="task-badge">2</div><h3>Review overview charts</h3></div>
      <p class="muted">Use the chart section for a quick sense of taxonomic coverage and function annotation quality.</p>
    </div>
    <div class="task-card">
      <div class="task-top"><div class="task-badge">3</div><h3>Browse result tables</h3></div>
      <p class="muted">Preview paginated tables in the browser, then export the full TSV files for downstream work.</p>
    </div>
    <div class="task-card">
      <div class="task-top"><div class="task-badge">4</div><h3>Look for run notes</h3></div>
      <p class="muted">Warnings explain skipped optional steps or input differences that may affect interpretation.</p>
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <div>
      <div class="panel-kicker">Input and settings</div>
      <h2>What was used</h2>
      <p class="panel-help">The detailed method settings are saved with the report so the analysis can be reproduced.</p>
    </div>
    <a class="action-link" href="config_used.yaml">Download method settings</a>
  </div>
  <div class="metric-grid">
    <div class="metric">
      <div class="label">OTF table</div>
      <div class="value">Provided</div>
      <div class="hint">{{ run_summary.otf_file }}</div>
    </div>
    <div class="metric">
      <div class="label">Metadata table</div>
      <div class="value">{{ "Provided" if run_summary.meta_file != "Generated internally" else "Generated" }}</div>
      <div class="hint">{{ run_summary.meta_file }}</div>
    </div>
    <div class="metric">
      <div class="label">Grouping column</div>
      <div class="value">{{ run_summary.group_column }}</div>
      <div class="hint">Used for group summaries and comparisons when available</div>
    </div>
    <div class="metric">
      <div class="label">Control group</div>
      <div class="value">{{ run_summary.control_group }}</div>
      <div class="hint">Used for group-vs-control testing when available</div>
    </div>
    <div class="metric">
      <div class="label">Statistics backend</div>
      <div class="value">{{ config.statistics.diff_method }}</div>
      <div class="hint">{{ dataset_summary.get("statistics_backend") }}</div>
    </div>
  </div>
  <details class="config-block">
    <summary>Show full method settings</summary>
    <pre>{{ config_yaml }}</pre>
  </details>
</div>
