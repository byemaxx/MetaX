DR   Q28DZ1, IKKA_XENTR ;  Q95KV0, IKKB_BOVIN ;  Q9VEZ5, IKKB_DROME ;
DR   O14920, IKKB_HUMAN ;  O88351, IKKB_MOUSE ;  Q9QY78, IKKB_RAT   ;
