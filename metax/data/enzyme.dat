DR   Q4ICG8, LCMT1_GIBZE;  Q9UIC8, LCMT1_HUMAN;  Q6CWW0, LCMT1_KLULA;
DR   Q4P4G2, LCMT1_MYCMD;  Q7SAP7, LCMT1_NEUCR;  Q6P4Z6, LCMT1_RAT  ;
DR   O94257, LCMT1_SCHPO;  Q6C997, LCMT1_YARLI;  Q04081, LCMT1_YEAST;
