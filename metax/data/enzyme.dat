DR   Q5NU32, AOFA_HORSE ;  P21397, AOFA_HUMAN ;  Q64133, AOFA_MOUSE ;
DR   Q6Q2J0, AOFA_PIG   ;  Q5RE60, AOFA_PONAB ;  P21396, AOFA_RAT   ;
DR   O18851, AOFA_SHEEP ;  P56560, AOFB_BOVIN ;  Q7YRB7, AOFB_CANLF ;
DR   P58028, AOFB_CAVPO ;  P27338, AOFB_HUMAN ;  Q8BW75, AOFB_MOUSE ;
DR   Q6PLK3, AOFB_PIG   ;  Q5RE98, AOFB_PONAB ;  P19643, AOFB_RAT   ;
