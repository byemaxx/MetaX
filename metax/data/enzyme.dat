DR   P65500, NADB_MYCBO ;  Q49617, NADB_MYCLE ;  P9WJJ8, NADB_MYCTO ;
DR   P9WJJ9, NADB_MYCTU ;  Q9JSX4, NADB_NEIMA ;  Q9K107, NADB_NEIMB ;
DR   Q8YXJ6, NADB_NOSS1 ;  Q6Z836, NADB_ORYSJ ;  Q51363, NADB_PSEAE ;
DR   Q9V2R0, NADB_PYRAB ;  Q8TZL4, NADB_PYRFU ;  O57765, NADB_PYRHO ;
