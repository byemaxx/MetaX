DR   Q8F3Q1, CIMA_LEPIN ;  Q8TJJ1, CIMA_METAC ;  Q58787, CIMA_METJA ;
DR   Q8TYM1, CIMA_METKA ;  P58966, CIMA_METMA ;  A3CUF2, CIMA_METMJ ;
DR   B8GEI1, CIMA_METPE ;  O26819, CIMA_METTH ;  O86511, CIMA_STRCO ;
DR   Q4J6H1, CIMA_SULAC ;  P74269, CIMA_SYNY3 ;  Q9WZ22, CIMA_THEMA ;
