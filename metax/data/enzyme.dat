DR   Q1JUZ2, NVD_BOMMO  ;  Q6DHJ3, NVD_DANRE  ;  Q1JUZ1, NVD_DROME  ;
DR   F7J188, NVD_HEMPU  ;  F7J184, NVD_XENLA  ;
