DR   Q9PPF1, UBIX_CAMJE ;  Q9PKH2, UBIX_CHLMU ;  Q9Z8S4, UBIX_CHLPN ;
DR   O84222, UBIX_CHLTR ;  Q9RR91, UBIX_DEIRA ;  P0AG04, UBIX_ECO57 ;
DR   P0AG03, UBIX_ECOLI ;  Q9KCC2, UBIX_HALH5 ;  Q9ZJE3, UBIX_HELPJ ;
DR   O26011, UBIX_HELPY ;  Q57566, UBIX_METJA ;  O26250, UBIX_METTH ;
DR   Q9JW78, UBIX_NEIMA ;  Q9JXP4, UBIX_NEIMB ;  Q9HX08, UBIX_PSEAE ;
DR   Q9V030, UBIX_PYRAB ;  O58742, UBIX_PYRHO ;  Q9ZD09, UBIX_RICPR ;
